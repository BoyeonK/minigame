# MiniGameServer(게임 서버) 환경변수 예제
#
# 이 파일을 같은 디렉토리에 ".env" 로 복사한 뒤 값을 채운다.
# .env 자체는 .gitignore 대상이므로 저장소에 올라가지 않는다.
#
# 읽는 곳: ServerGlobal.cpp 의 EnvManager
#   - "#" 로 시작하는 줄과 빈 줄은 무시된다.
#   - 첫 "=" 를 기준으로 KEY=VALUE 로 자르고 양끝 공백을 Trim 한다.
#   - MiniGameDB 쪽과 달리 프로세스 환경변수로 올리지 않고 내부 맵에 담아둔다.
#
# 사용처는 전부 Server.cpp 의 main() 시작부 (DB와의 gRPC 채널 생성).

# MiniGameDB 의 gRPC 주소.
# MiniGameDB 는 main.cpp 에서 0.0.0.0:50051 로 고정 리슨한다.
DB_ADDRESS=127.0.0.1:50051

# DB 서버 인증서 파일 경로. EnvManager::ReadFile() 로 통째로 읽어
# grpc::SslCredentialsOptions::pem_root_certs 에 넣는다.
# 자체 서명 인증서를 쓰므로 MiniGameDB 의 server.crt 와 같은 파일이어야 한다.
# 상대 경로는 이 exe 의 작업 디렉토리 기준이다.
CERTNAME=server.crt

# SSL target name override.
# 위 인증서의 CN(Common Name)과 반드시 일치해야 한다.
# 일치하지 않으면 핸드셰이크가 실패한다.
CNNAME=MiniGameDB
