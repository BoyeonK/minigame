# MiniGameDB 환경변수 예제
#
# 이 파일을 같은 디렉토리에 ".env" 로 복사한 뒤 값을 채운다.
# .env 자체는 .gitignore 대상이므로 저장소에 올라가지 않는다.
#
# 읽는 곳: GlobalVariables.cpp 의 DBManager::SetEnv()
#   - "#" 로 시작하는 줄과 빈 줄은 무시된다.
#   - 첫 "=" 를 기준으로 KEY=VALUE 로 자른다.
#   - VALUE 가 큰따옴표로 감싸여 있으면 따옴표를 벗긴다.
#   - 값은 SetEnvironmentVariableW() 로 프로세스 환경변수에 올라간 뒤
#     ConnectNewHDbc() 에서 _wdupenv_s() 로 다시 읽힌다.
#
# 주의: wstring(s.begin(), s.end()) 로 단순 확장하므로 ASCII 만 사용할 것.
#       (한글이 들어가면 깨진다)
#
# 최종 연결 문자열은 ConnectNewHDbc() 에서 이렇게 조립된다:
#   Driver={ODBC Driver 17 for SQL Server};Server=<DB_SERVER>;Database=<DB_NAME>;<CONNECTION>;

# SQL Server 인스턴스 주소.
#   로컬 named instance 예: localhost\SQLEXPRESS
#   기본 instance 예:       localhost
#   원격 예:                192.168.0.10,1433
DB_SERVER=localhost\SQLEXPRESS

# 데이터베이스 이름. schema.sql 이 만드는 이름과 반드시 일치해야 한다.
# 프로젝트 이름은 MiniGameDB 이지만 실제 DB 이름은 MyGameDB 다. 헷갈리기 쉬우니 주의.
DB_NAME=MyGameDB

# 연결 문자열의 인증 부분. 위 템플릿의 마지막에 그대로 이어 붙는다.
#   Windows 인증:  Trusted_Connection=Yes
#   SQL 인증:      UID=sa;PWD=<password>
#
# 값에 "=" 가 들어가지만 파서가 "첫 번째" = 로만 자르므로 문제없다.
# 큰따옴표는 있어도 되고 없어도 된다(파서가 양끝 따옴표를 벗겨낸다).
CONNECTION="Trusted_Connection=Yes"
