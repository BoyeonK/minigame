# Unity 기본 파일 무시
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
UIElementsSchema/
BuildFiles/
Include/
Protobuf/
env/

# 음원 파일 무시
[Ss]ounds/
[Aa]udio/

# Unity 에셋 스토어 관련 파일 무시
TinyRPGTown/
Tiny RPG Forest/
TextMesh Pro/
Unity UI Samples/
UI Toolkit/
# LowPoly로 시작하는 에셋 팩 전부 (개별 지정하면 새로 받을 때마다 누락된다)
LowPoly*/
LowPoly*.meta
Haons SD series Pack/
uchwch/
unity-chan!/
Packages/
LocalPackages/

# Baked된 광원 효과 무시
MiniGameClient/Assets/Scenes/Login/

# Fonts 무시
Fonts/

# Visual Studio 관련 파일 무시
.vs/
*.csproj
3D practice.sln
UnityClient.sln
*.userprefs

# Visual Studio C++ 빌드 중간 산출물 무시
# vcxproj의 OutDir은 BuildFiles/ 로 잡혀 있지만,
# obj/pdb/log/tlog 같은 중간 산출물은 프로젝트 기본값인 Debug/, Release/ 로 떨어진다.
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.obj
*.pdb
*.idb
*.ilk
*.tlog/
*.log

# OS별 불필요한 파일 무시
.DS_Store
Thumbs.db

# 빌드된 실행 파일 무시
*.apk
*.exe
*.dll

# 단, Plugins의 dll은 빌드 산출물이 아니라 클라이언트 실행에 필요한 외부 의존성이다.
# 저장소에서 빠지면 유실 시 버전을 맞춰 다시 구해야 하므로 추적한다.
# (.meta 파일들은 애초에 무시 대상이 아니라 이미 추적 중)
!MiniGameClient/Assets/Plugins/*.dll

# 환경변수 무시
.env
GitIgnores.cs

# 인증서 관련 파일 무시
*.crt
*.csr
*.key